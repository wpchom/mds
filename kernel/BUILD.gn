declare_args() {
  # config
  mds_core_arch = ""
  mds_config_file = ""
}

config("mds_kernel_cfg") {
  include_dirs = [ "../include" ]
  defines = []

  if (defined(mds_config_file) && mds_config_file != "") {
    defines += [ "MDS_CONFIG_FILE=\"" + mds_config_file + "\"" ]
  } else if (mds_core_arch == "") {
    if (defined(target_os) && target_os != "") {
      _target_os = target_os
    } else {
      _target_os = host_os
    }

    if (_target_os == "mac") {
      defines += [
        "CONFIG_MDS_INIT_SECTION=\"rodata,init.mdsInit.\"",
        "CONFIG_MDS_LOG_FORMAT_SECTION=\"rodata,logfmt.\"",
      ]
    }

    # add other os
  }
}

static_library("mds_kernel") {
  sources = [
    "critical.c",
    "device.c",
    "log.c",
    "lpc.c",
    "object.c",
    "utils.c",
  ]

  sources += [
    "sys/clock.c",
    "sys/idle.c",
    "sys/ipc/condition.c",
    "sys/ipc/event.c",
    "sys/ipc/mempool.c",
    "sys/ipc/msgqueue.c",
    "sys/ipc/mutex.c",
    "sys/ipc/rwlock.c",
    "sys/ipc/semaphore.c",
    "sys/kernel.c",
    "sys/scheduler.c",
    "sys/thread.c",
    "sys/timer.c",
    "sys/workq.c",
  ]

  sources += [
    "mm/heap.c",
    "mm/llff.c",
  ]

  if (mds_core_arch != "") {
    sources += [ "arch/" + mds_core_arch + ".c" ]
  }

  public_configs = [ ":mds_kernel_cfg" ]
}
