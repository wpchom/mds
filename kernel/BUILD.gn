declare_args() {
  mds_kernel_pkgcfg = {
    archcore = ""
    nosys = false
  }
}

source_set("mds_kernel") {
  sources = [
    "critical.c",
    "device.c",
    "log.c",
    "lpc.c",
    "object.c",
    "utils.c",
  ]

  defines = []

  if (defined(mds_kernel_pkgcfg.archcore) && mds_kernel_pkgcfg.archcore != "") {
    sources += [ "arch/" + mds_kernel_pkgcfg.archcore + ".c" ]
  }

  if (defined(mds_kernel_pkgcfg.nosys) && mds_kernel_pkgcfg.nosys) {
    sources += [ "nosys.c" ]
    defines += [ "CONFIG_MDS_KERNEL_THREAD_PRIORITY_MAX=0" ]
  } else {
    sources += [
      "sys/clock.c",
      "sys/idle.c",
      "sys/ipc/condition.c",
      "sys/ipc/event.c",
      "sys/ipc/mempool.c",
      "sys/ipc/msgqueue.c",
      "sys/ipc/mutex.c",
      "sys/ipc/rwlock.c",
      "sys/ipc/semaphore.c",
      "sys/kernel.c",
      "sys/scheduler.c",
      "sys/thread.c",
      "sys/timer.c",
      "sys/workq.c",
    ]
  }

  sources += [
    "mm/heap.c",
    "mm/llff.c",
  ]

  public_configs = [ "../:mds_cfg" ]
}
