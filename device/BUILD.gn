config("mds_device_cfg") {
  include_dirs = [ "../include/device" ]
}

static_library("mds_device") {
  sources = [
    "dev_adc.c",
    "dev_gpio.c",
    "dev_i2c.c",
    "dev_i2s.c",
    "dev_led.c",
    "dev_qspi.c",
    "dev_rtc.c",
    "dev_spi.c",
    "dev_storage.c",
    "dev_timer.c",
    "dev_uart.c",
  ]

  public_configs = [ ":mds_device_cfg" ]

  public_deps = [ "../:kernel" ]
}
